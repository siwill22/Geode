{
  "name": "geode",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check_archive_present.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pack:deploy": "node ../prep/pack_deploy.mjs",
    "check:mask": "node scripts/dump_masks.mjs /tmp/geode-masks.json && ${GEODE_PYTHON:-python} ../test-data/check_mask.py /tmp/geode-masks.json",
    "check:query-point": "node scripts/check_query_point.mjs",
    "check:static-polygons": "node scripts/check_static_polygons.mjs",
    "check:render": "node scripts/shoot.mjs shots",
    "check:paleobio": "node scripts/check_paleobio.mjs shots-paleobio",
    "check:boundaries": "cd .. && PYTHONPATH=\"$PYTHONPATH:$PWD/viewer/vendor/petrify/python\" ${GEODE_PYTHON:-python} prep/check_boundaries.py",
    "check:projections": "node scripts/check_projections.mjs shots-projections",
    "check:flat-direction": "node scripts/check_flat_direction.mjs",
    "check:robinson": "cd .. && ${GEODE_PYTHON:-python} prep/check_robinson.py",
    "check:storymaps": "node scripts/check_storymaps.mjs",
    "check:oldmap": "node scripts/check_oldmap.mjs",
    "check:themes": "node scripts/check_themes.mjs",
    "check:theme-roles": "node scripts/check_theme_roles.mjs",
    "check:themelab": "node scripts/check_themelab.mjs shots-themelab"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "type": "module"
}
