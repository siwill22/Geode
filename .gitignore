# Generated archive: ~87 MB of derived data, rebuilt by prep/*.py.
# See the README for the regeneration commands.
/archive/

# The deployable subset, rebuilt by prep/pack_deploy.mjs and uploaded as a
# release asset. Deriving it is cheap; committing it would defeat the point of
# keeping the data out of git history entirely.
/archive-deploy/
/archive-deploy.tar.gz

# viewer/public/archive is a relative symlink to /archive and IS tracked,
# so a fresh clone wires up correctly once the prep scripts have been run.

# Raw netCDFs fetched from the BRIDGE server by fetch_bridge.py (~1.7 GB) --
# fully reproducible from prep/bridge_runs.py, shouldn't live in git history.
/prep/cache/

node_modules/
dist/
shots/
shots-*/

__pycache__/
*.pyc

.DS_Store
